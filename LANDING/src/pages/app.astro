---
// Página del QR de Welltur (ExpoCiencias y eventos).
// Android: avisa que es compatible y ofrece instalar (descarga + pasos) o probar la demo.
// iPhone/iPad: abre la demo web de la app (no hay App Store todavía).
// Computadora: muestra ambas opciones.
const APK_URL = "https://github.com/tinnlaroli/smartur-movil/releases/latest/download/app-release.apk";
const DEMO_URL = "/demo/";
const TITULO = "Welltur · Bienestar en las Altas Montañas";
const DESCRIPCION =
  "Cuéntanos cómo te has sentido y qué buscas: te sugerimos experiencias de bienestar en negocios locales de las Altas Montañas de Veracruz.";
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{TITULO}</title>
    <meta name="description" content={DESCRIPCION} />
    <meta name="theme-color" content="#f4eee3" />
    <meta property="og:title" content={TITULO} />
    <meta property="og:description" content={DESCRIPCION} />
    <meta property="og:image" content="https://smartur.online/welltur-logo.png" />
    <meta property="og:url" content="https://smartur.online/app/" />
    <meta property="og:type" content="website" />
    <link rel="icon" href="/welltur-logo.png" type="image/png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Cal+Sans&family=Outfit:wght@400;500;600;700&display=swap"
    />
    <style>
      :root {
        --bosque: #2b4d3d;
        --bosque-2: #1f3a2e;
        --salvia: #5f8470;
        --arena: #d9c49c;
        --terracota: #c4744f;
        --crema: #f4eee3;
        --tinta: #1d2a23;
        --tenue: #5d6b63;
        --borde: rgba(43, 77, 61, 0.12);
      }
      * { box-sizing: border-box; }
      html { -webkit-text-size-adjust: 100%; }
      body {
        margin: 0;
        min-height: 100dvh;
        font-family: "Outfit", system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
        color: var(--tinta);
        background: var(--crema);
        overflow-x: hidden;
      }
      /* Fondo orgánico: manchas suaves con los colores del logo */
      .fondo { position: fixed; inset: 0; z-index: 0; pointer-events: none; overflow: hidden; }
      .fondo span { position: absolute; border-radius: 50%; filter: blur(48px); opacity: 0.55; }
      .fondo .a { width: 340px; height: 340px; background: #a9c3b2; top: -120px; left: -110px; }
      .fondo .b { width: 300px; height: 300px; background: var(--arena); top: 60px; right: -140px; opacity: 0.5; }
      .fondo .c { width: 280px; height: 280px; background: #e7b597; bottom: -120px; left: 20%; opacity: 0.35; }

      .pagina {
        position: relative; z-index: 1; max-width: 460px; margin: 0 auto;
        padding: calc(28px + env(safe-area-inset-top)) 18px calc(28px + env(safe-area-inset-bottom));
      }
      .cabecera { text-align: center; }
      .logo { width: 168px; height: auto; display: block; margin: 0 auto; filter: drop-shadow(0 10px 22px rgba(31, 58, 46, 0.18)); }
      .ceja {
        display: inline-block; margin-top: 18px; padding: 6px 12px; border-radius: 999px;
        background: rgba(95, 132, 112, 0.14); color: var(--bosque);
        font-size: 11.5px; font-weight: 700; letter-spacing: 1.4px; text-transform: uppercase;
      }
      h1 {
        font-family: "Cal Sans", "Outfit", sans-serif; font-weight: 400; color: var(--bosque-2);
        font-size: clamp(32px, 9.5vw, 42px); line-height: 1.04; margin: 12px 0 10px; letter-spacing: 0.2px;
      }
      h1 em { font-style: normal; color: var(--terracota); }
      .lead { margin: 0 auto; max-width: 360px; font-size: 16px; line-height: 1.5; color: var(--tenue); }

      .tarjeta {
        margin-top: 22px; padding: 22px 20px; border-radius: 28px;
        background: rgba(255, 255, 255, 0.78);
        -webkit-backdrop-filter: blur(14px); backdrop-filter: blur(14px);
        border: 1px solid rgba(255, 255, 255, 0.9);
        box-shadow: 0 1px 0 rgba(255, 255, 255, 0.8) inset, 0 22px 50px rgba(31, 58, 46, 0.14);
      }
      .oculto { display: none !important; }
      .sello {
        display: flex; align-items: center; gap: 12px; margin-bottom: 16px;
        padding: 12px 14px; border-radius: 18px; background: rgba(95, 132, 112, 0.12);
      }
      .sello .ok {
        flex: 0 0 38px; height: 38px; border-radius: 50%; background: var(--salvia); color: #fff;
        display: flex; align-items: center; justify-content: center;
      }
      .sello .ok svg { width: 20px; height: 20px; }
      .sello b { display: block; font-size: 16px; color: var(--bosque-2); }
      .sello span { font-size: 13.5px; color: var(--tenue); }
      h2 {
        font-family: "Cal Sans", "Outfit", sans-serif; font-weight: 400; color: var(--bosque-2);
        font-size: 23px; line-height: 1.2; margin: 0 0 6px;
      }
      .sub { margin: 0; color: var(--tenue); font-size: 15px; line-height: 1.5; }
      .acciones { display: grid; gap: 10px; }
      .boton {
        position: relative; display: flex; align-items: center; justify-content: center; gap: 10px;
        width: 100%; min-height: 58px; padding: 14px 18px; border-radius: 20px; border: 0;
        background: linear-gradient(135deg, #36604b, var(--bosque-2)); color: #fff;
        font: 700 17px/1.2 "Outfit", sans-serif; text-decoration: none;
        box-shadow: 0 12px 24px rgba(31, 58, 46, 0.28), 0 1px 0 rgba(255, 255, 255, 0.18) inset;
        -webkit-tap-highlight-color: transparent; transition: transform 0.12s ease, box-shadow 0.12s ease;
      }
      .boton:active { transform: scale(0.98); box-shadow: 0 6px 14px rgba(31, 58, 46, 0.25); }
      .boton svg { width: 21px; height: 21px; flex: 0 0 auto; }
      .boton .peso { font-weight: 500; opacity: 0.7; font-size: 14px; }
      .boton.suave {
        background: #fff; color: var(--bosque); box-shadow: none; border: 1.5px solid var(--borde);
      }
      .estado { display: flex; align-items: center; gap: 8px; font-size: 14px; color: var(--salvia); font-weight: 600; margin: 4px 0 2px; }
      ol { margin: 14px 0 16px; padding: 0; list-style: none; counter-reset: paso; }
      ol li {
        counter-increment: paso; display: flex; gap: 12px; padding: 12px 0;
        font-size: 15px; line-height: 1.45; border-top: 1px solid var(--borde);
      }
      ol li:first-child { border-top: 0; }
      ol li::before {
        content: counter(paso); flex: 0 0 28px; height: 28px; border-radius: 50%;
        background: var(--bosque); color: #fff; font-weight: 700; font-size: 14px;
        display: flex; align-items: center; justify-content: center; margin-top: 1px;
      }
      .nota { font-size: 13px; color: var(--tenue); line-height: 1.5; margin: 0 0 14px; }
      .aviso {
        font-size: 13.5px; line-height: 1.5; margin: 0 0 14px; padding: 12px 14px; border-radius: 16px;
        background: #fbede4; color: #7a3f22;
      }
      .girando {
        width: 16px; height: 16px; border-radius: 50%;
        border: 2.5px solid rgba(95, 132, 112, 0.25); border-top-color: var(--salvia);
        animation: girar 0.9s linear infinite;
      }
      @keyframes girar { to { transform: rotate(360deg); } }

      .rasgos { display: grid; grid-template-columns: repeat(3, 1fr); gap: 10px; margin-top: 16px; }
      .rasgo {
        padding: 14px 10px 12px; border-radius: 20px; text-align: center;
        background: rgba(255, 255, 255, 0.62); border: 1px solid rgba(255, 255, 255, 0.9);
      }
      .rasgo .ic {
        width: 40px; height: 40px; margin: 0 auto 8px; border-radius: 14px;
        display: flex; align-items: center; justify-content: center; color: #fff;
      }
      .rasgo .ic svg { width: 21px; height: 21px; }
      .rasgo b { display: block; font-size: 13.5px; line-height: 1.2; color: var(--bosque-2); }
      .rasgo span { display: block; margin-top: 3px; font-size: 11.5px; line-height: 1.3; color: var(--tenue); }

      footer { text-align: center; font-size: 12.5px; color: var(--tenue); margin-top: 22px; line-height: 1.7; }
      footer a { color: var(--bosque); font-weight: 700; text-decoration: none; border-bottom: 1.5px solid rgba(43, 77, 61, 0.25); }

      /* Entrada suave */
      .entra { animation: subir 0.6s cubic-bezier(0.2, 0.8, 0.2, 1) both; }
      .entra.d1 { animation-delay: 0.06s; } .entra.d2 { animation-delay: 0.14s; } .entra.d3 { animation-delay: 0.22s; }
      /* Solo desliza: el contenido nunca empieza invisible (si el navegador retrasa la
         animación, la página no se ve vacía). */
      @keyframes subir { from { transform: translateY(12px); } to { transform: none; } }
      @media (prefers-reduced-motion: reduce) { .entra, .girando { animation: none; } }

      /* Teléfonos bajos: las dos opciones caben sin desplazar. */
      @media (max-height: 720px) {
        .pagina { padding-top: calc(16px + env(safe-area-inset-top)); }
        .logo { width: 132px; }
        .ceja { margin-top: 12px; }
        h1 { font-size: 30px; margin: 8px 0 6px; }
        .lead { font-size: 14.5px; }
        .tarjeta { margin-top: 16px; padding: 18px 16px; }
        .sello { margin-bottom: 12px; padding: 10px 12px; }
      }
    </style>
  </head>
  <body>
    <div class="fondo" aria-hidden="true"><span class="a"></span><span class="b"></span><span class="c"></span></div>

    <div class="pagina">
      <header class="cabecera">
        <img class="logo entra" src="/welltur-logo.png" alt="Welltur" width="168" height="105" />
        <span class="ceja entra d1">Bienestar · Altas Montañas</span>
        <h1 class="entra d1">Viaja para <em>sentirte mejor</em></h1>
        <p class="lead entra d2">Cuéntanos cómo te has sentido y qué buscas: te sugerimos experiencias de bienestar en negocios locales.</p>
      </header>

      <!-- Android: primero se elige; al instalar empieza la descarga y aparecen los pasos -->
      <section id="android" class="tarjeta entra d3 oculto" aria-live="polite">
        <p id="aviso-webview" class="aviso oculto">
          Estás en el navegador de otra app. Si la descarga no empieza, toca <strong>⋮</strong> y elige
          <strong>Abrir en Chrome</strong>.
        </p>
        <div class="sello">
          <span class="ok" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12.5l4.5 4.5L19 7.5" /></svg></span>
          <div><b>¡Tu teléfono es compatible!</b><span>Instálala o pruébala sin instalar.</span></div>
        </div>
        <div class="acciones">
          <a class="boton" id="instalar" href={APK_URL}>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 4v11m0 0l-4.5-4.5M12 15l4.5-4.5M5 20h14" /></svg>
            Instalar la app <span class="peso">· 83 MB</span>
          </a>
          <a class="boton suave" href={DEMO_URL}>Probar sin instalar</a>
        </div>
      </section>

      <section id="android-pasos" class="tarjeta oculto" aria-live="polite">
        <h2>Descargando…</h2>
        <p class="estado"><span class="girando" aria-hidden="true"></span> Sigue estos pasos mientras termina</p>
        <ol>
          <li><span>Toca la notificación de descarga o abre <strong>Descargas</strong> y elige <strong>app-release.apk</strong>.</span></li>
          <li><span>Si dice “no se permite instalar apps de esta fuente”, toca <strong>Configuración</strong> y activa <strong>Permitir de esta fuente</strong>.</span></li>
          <li><span>Regresa y toca <strong>Instalar</strong>. Si Play Protect pregunta, elige <strong>Instalar de todas formas</strong>.</span></li>
          <li><span>Abre la app y entra a <strong>Welltur</strong> para recibir tu recomendación.</span></li>
        </ol>
        <p class="nota">Versión oficial del equipo, publicada en GitHub. Si puedes, usa Wi-Fi.</p>
        <div class="acciones">
          <a class="boton" href={APK_URL}>¿No empezó? Descargar de nuevo</a>
          <a class="boton suave" href={DEMO_URL}>Mejor pruebo sin instalar</a>
        </div>
      </section>

      <!-- iPhone / iPad: se abre la demo web -->
      <section id="ios" class="tarjeta entra d3 oculto" aria-live="polite">
        <h2>Abriendo Welltur…</h2>
        <p class="estado"><span class="girando" aria-hidden="true"></span> Un momento</p>
        <p class="sub" style="margin: 8px 0 16px">Aún no estamos en la App Store: abrimos la versión web, funciona igual y sin instalar nada.</p>
        <div class="acciones"><a class="boton" href={DEMO_URL}>Abrir ahora</a></div>
      </section>

      <!-- Computadora u otros -->
      <section id="otros" class="tarjeta entra d3 oculto">
        <h2>Pruébala ahora</h2>
        <p class="sub" style="margin-bottom: 16px">Escanea el QR con tu teléfono o abre la versión web aquí.</p>
        <div class="acciones">
          <a class="boton" href={DEMO_URL}>Abrir la versión web</a>
          <a class="boton suave" href={APK_URL}>Descargar para Android <span class="peso">· APK</span></a>
        </div>
      </section>

      <noscript>
        <section class="tarjeta">
          <div class="acciones">
            <a class="boton" href={APK_URL}>Instalar en Android</a>
            <a class="boton suave" href={DEMO_URL}>Probar sin instalar</a>
          </div>
        </section>
      </noscript>

      <div class="rasgos entra d3">
        <div class="rasgo">
          <span class="ic" style="background: var(--salvia)" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 21c-4-3-7-6.5-7-10.5C5 6.5 8 4 12 3c4 1 7 3.5 7 7.5 0 4-3 7.5-7 10.5z" /><path d="M12 8v8" /></svg></span>
          <b>A tu medida</b><span>Según cómo te sientes</span>
        </div>
        <div class="rasgo">
          <span class="ic" style="background: #b99a62" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="6" cy="18" r="2" /><circle cx="18" cy="6" r="2" /><path d="M8 18h6a4 4 0 000-8H10a4 4 0 010-8h6" /></svg></span>
          <b>Rutas reales</b><span>Por carretera</span>
        </div>
        <div class="rasgo">
          <span class="ic" style="background: var(--terracota)" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 10l1.5-5h15L21 10M4 10v10h16V10M3 10h18M9 20v-6h6v6" /></svg></span>
          <b>Negocio local</b><span>MiPyMEs de la región</span>
        </div>
      </div>

      <footer>
        ExpoCiencias 2026 · Universidad Tecnológica del Centro de Veracruz<br />
        <a href="/">Conocer el proyecto</a> · No sustituye atención médica.
      </footer>
    </div>

    <script is:inline define:vars={{ DEMO_URL }}>
      const ua = navigator.userAgent || "";
      // iPadOS se presenta como Mac: se distingue por la pantalla táctil.
      const esIOS = /iPhone|iPad|iPod/i.test(ua) || (/Macintosh/.test(ua) && navigator.maxTouchPoints > 1);
      const esAndroid = /Android/i.test(ua);
      // Navegadores dentro de otras apps (WhatsApp, Instagram, Facebook…) a veces bloquean descargas.
      const enOtraApp = /\bwv\)|FBAN|FBAV|Instagram|Line\/|WhatsApp|TikTok|Snapchat/i.test(ua);
      const mostrar = (id) => document.getElementById(id).classList.remove("oculto");
      const ocultar = (id) => document.getElementById(id).classList.add("oculto");

      if (esIOS) {
        mostrar("ios");
        setTimeout(() => location.replace(DEMO_URL), 1400);
      } else if (esAndroid) {
        mostrar("android");
        if (enOtraApp) mostrar("aviso-webview");
        // La descarga sale del toque (Chrome bloquea descargas sin gesto): el enlace sigue a
        // GitHub y la tarjeta cambia a los pasos.
        document.getElementById("instalar").addEventListener("click", () => {
          ocultar("android");
          mostrar("android-pasos");
          window.scrollTo({ top: 0, behavior: "smooth" });
        });
      } else {
        mostrar("otros");
      }
    </script>
  </body>
</html>
